# Copia a .env en el servidor (nunca en git).
PORT=3100
SITE_URL=https://www.betanbm.com
TRUST_PROXY=1            # detrás de nginx
CANONICAL_REDIRECT=0     # nginx ya redirige betanbm.com -> www
HASH_SALT=pon-una-cadena-larga-aleatoria
ADMIN_TOKEN=pon-un-token-largo-aleatorio   # panel /api/admin/*; vacío = desactivado
LEADS_RETENTION_DAYS=730
EVENTS_RETENTION_DAYS=395
DOCS_SECRET=pon-otra-cadena-larga-aleatoria   # firma los enlaces de la documentación
DOCS_TTL_DAYS=30

# Correo (por ejemplo Gmail con contraseña de aplicación: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=fco.rubio.ortega@gmail.com
SMTP_PASS=
MAIL_FROM=Betan <fco.rubio.ortega@gmail.com>
MAIL_TO=fco.rubio.ortega@gmail.com
MAIL_AUTOREPLY=1
